# SHAZA API -- copy to .env and adjust.

ENVIRONMENT=development

# PostgreSQL is the target (charter section 8). Local dev falls back to SQLite so the pipeline
# runs without Docker -- see docs/decisions/0002-sqlite-for-local-dev.md.
# DATABASE_URL=postgresql+psycopg://shaza:shaza@localhost:5432/shaza
DATABASE_URL=sqlite:///./shaza.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

HTTP_TIMEOUT_SECONDS=30
